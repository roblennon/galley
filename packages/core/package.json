{
  "name": "@galley/core",
  "version": "0.2.0",
  "description": "Parse, author, validate, and reconcile inline Markdown annotations (constrained CriticMarkup profile with identifiers).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roblennon/galley.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/roblennon/galley#readme",
  "bugs": "https://github.com/roblennon/galley/issues",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && vitest run && node scripts/fuzz.mjs 500",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fuzz": "node scripts/fuzz.mjs 800",
    "prepack": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "markdown",
    "criticmarkup",
    "annotations",
    "comments",
    "editing",
    "llm",
    "galley",
    "spec"
  ],
  "author": "Rob Lennon",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
